      <button class="btn-muted" onclick="hideHelp()">بستن</button>
    </div>
  </div>
</div>

<script>
  // Service Worker - generic for current page
  if('serviceWorker' in navigator){
    try{
      const swCode = `
        const CACHE_NAME = 'bread-proplus-fixed-v2';
        self.addEventListener('install', e=>{ 
          e.waitUntil(caches.open(CACHE_NAME).then(c=>c.addAll(['./']).catch(()=>{})); 
          self.skipWaiting(); 
        });
        self.addEventListener('activate', e=>{ e.waitUntil(self.clients.claim()); });
        self.addEventListener('fetch', e=>{ 
          e.respondWith(
            caches.match(e.request).then(r=> r || fetch(e.request).then(resp=>{ 
              try{ const resClone = resp.clone(); caches.open(CACHE_NAME).then(c=>c.put(e.request, resClone)); }catch(_){} 
              return resp; 
            }).catch(()=>caches.match('./')))
          ); 
        });
      `;
      const blob = new Blob([swCode], { type: 'text/javascript' });
      const swUrl = URL.createObjectURL(blob);
      navigator.serviceWorker.register(swUrl).then(()=>console.log('Inline SW registered')).catch(e=>console.warn('inline SW failed', e));
    }catch(e){ console.warn('SW inline register failed', e); }
  }

  // Manifest (بهتر برای iOS و Android)
  try{
    const iconSvg = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect fill='%23c5a972' width='100' height='100' rx='20'/%3E%3Ctext x='50' y='68' font-size='55' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'%3Eس%3C/text%3E%3C/svg%3E";
    const manifest = {
      name: 'سیستم مدیریت نان خشکه - مجتمع سنت',
      short_name: 'نان خشکه',
      start_url: '.',
      display: 'standalone',
      orientation: 'any',
      background_color: '#f6f1e6',
      theme_color: '#c5a972',
      lang: 'fa',
      dir: 'rtl',
      icons: [
        { src: iconSvg, sizes: '192x192', type: 'image/svg+xml', purpose: 'any maskable' },
        { src: iconSvg, sizes: '512x512', type: 'image/svg+xml', purpose: 'any maskable' }
      ]
    };
    const l = document.createElement('link'); l.rel='manifest'; l.href = 'data:application/json,' + encodeURIComponent(JSON.stringify(manifest)); document.head.appendChild(l);
  }catch(e){}

  let tfReady = false;
  async function ensureTF(){
    if(tfReady) return window.tf;
    if(window.tf) { tfReady = true; return window.tf; }
    await new Promise((resolve,reject)=>{
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.9.0/dist/tf.min.js';
      s.onload = () => resolve(); s.onerror = (e)=>reject(e);
      document.head.appendChild(s);
    });
    tfReady = true;
    return window.tf;
  }

const STORAGE_KEY_LOGS = 'nk_logs_v1';
const STORAGE_KEY_PRICE_HISTORY = 'nk_price_history_v1';
const STORAGE_KEY_SETTINGS = 'nk_settings_v1';
const STORAGE_KEY_ARCHIVE = 'nk_archive_v1';

let idb = null;
let idbInitPromise = null;

function initIndexedDB(){
  if (idb) return Promise.resolve(idb);
  if (idbInitPromise) return idbInitPromise;

  idbInitPromise = new Promise((resolve, reject) => {
    if (!window.indexedDB) {
      console.warn('IndexedDB not supported – falling back to localStorage');
      idb = null;
      resolve(null);
      return;
    }

    const req = indexedDB.open('NanKhoshkehDB', 5);
    
    req.onupgradeneeded = function(e){
      const db = e.target.result;
      if(!db.objectStoreNames.contains('logs')) 
        db.createObjectStore('logs', { keyPath: 'date' });
      if(!db.objectStoreNames.contains('priceHistory')) 
        db.createObjectStore('priceHistory', { autoIncrement: true });
      if(!db.objectStoreNames.contains('settings')) 
        db.createObjectStore('settings', { keyPath: 'key' });
    };

    req.onsuccess = async function(e){ 
      try {
        idb = e.target.result;
        console.log('IndexedDB initialized successfully');
        
        // Ensure stores exist (safety)
        if (!idb.objectStoreNames.contains('logs') || 
            !idb.objectStoreNames.contains('priceHistory') || 
            !idb.objectStoreNames.contains('settings')) {
          console.warn('Missing stores, closing and retrying...');
          idb.close();
          idb = null;
          // Force higher version next time
          resolve(null);
          return;
        }

        const savedSettings = await idbGetAll('settings');
        
        if (savedSettings.length === 0) {
          console.log('هیچ تنظیماتی پیدا نشد. اعمال پیش‌فرض‌ها...');
          setDefaults();
          await saveSettings();
        } else {
          console.log('تنظیمات ذخیره‌شده بارگذاری شد.');
          await loadSettingsToUI();
        }

        await updatePriceHistoryChart();
        await renderLogs();
        await renderLineChart();
        await calc();
        
        resolve(idb);
      } catch(err) {
        console.error('Error in onsuccess:', err);
        idb = null;
        resolve(null); // soft fail – use localStorage fallback
      }
    };

    req.onerror = function(e){ 
      console.error('IndexedDB initialization error:', e.target.error);
      idb = null;
      resolve(null); // soft fail
    };

    req.onblocked = function(){
      console.warn('IndexedDB blocked – another tab may be open');
      resolve(null);
    };
  });

  return idbInitPromise;
}

/** Ensure IDB is ready; returns true if usable */
async function ensureIdb(){
  if (idb) return true;
  await initIndexedDB();
  return !!idb;
}

function idbPut(storeName, value){
  return new Promise((resolve, reject) => {
    if(!idb) return resolve(false);
    const tx = idb.transaction(storeName, 'readwrite');
    const st = tx.objectStore(storeName);
    const req = st.put(value);
    req.onsuccess = ()=>resolve(true);
    req.onerror = (e)=>reject(e);
  });
}
function idbGetAll(storeName){
  return new Promise((resolve)=> {
    if(!idb) return resolve([]);
    const tx = idb.transaction(storeName,'readonly');
    const st = tx.objectStore(storeName);
    const req = st.getAll();
    req.onsuccess = ()=>resolve(req.result || []);
    req.onerror = ()=>resolve([]);
  });
}
function idbGet(storeName, key){
  return new Promise((resolve)=> {
    if(!idb) return resolve(null);
    const tx = idb.transaction(storeName,'readonly');
    const st = tx.objectStore(storeName);
    const req = st.get(key);
    req.onsuccess = ()=>resolve(req.result || null);
    req.onerror = ()=>resolve(null);
  });
}
function idbDelete(storeName, key){
  return new Promise((resolve)=> {
    if(!idb) return resolve(false);
    const tx = idb.transaction(storeName,'readwrite');
    const st = tx.objectStore(storeName);
    const req = st.delete(key);
    req.onsuccess = ()=>resolve(true);
    req.onerror = ()=>resolve(false);
  });
}

function loadLogsLocal(){ try{ return JSON.parse(localStorage.getItem(STORAGE_KEY_LOGS) || '[]'); }catch(e){return []} }
function saveLogsLocal(arr){ localStorage.setItem(STORAGE_KEY_LOGS, JSON.stringify(arr)); }

function computeCosts(){
  const p=[], u=[];
  for(let i=1;i<=11;i++){
    p[i] = parseFloat(document.getElementById('price'+i)?.value) || 0;
    u[i] = parseFloat(document.getElementById('use'+i)?.value) || 0;
  }
  // price is for the package size, use is kg per dough/batch
  const c1 = p[1]*(u[1]/40), c2 = p[2]*(u[2]/40), c3 = p[3]*u[3],
        c4 = p[4]*(u[4]/17), c5 = p[5]*(u[5]/10), c6 = p[6]*(u[6]/10),
        c7 = p[7]*u[7], c8 = p[8]*u[8], c9 = p[9]*u[9],
        c10 = p[10]*u[10],
        c11 = p[11]*u[11];
  const materialsTotal = c1+c2+c3+c4+c5+c6+c7+c8+c9+c10+c11;

  const laborMonth = parseFloat(document.getElementById('labor_month').value) || 0;
  const rentMonth = parseFloat(document.getElementById('rent_month').value) || 0;
  const utilitiesDay = parseFloat(document.getElementById('utilities_day').value) || 0;
  const laborDay = laborMonth/30;
  const rentDay = rentMonth/30;

  const packagesDay = parseFloat(document.getElementById('packages_day').value) || 1;
  const weightGram = parseFloat(document.getElementById('weight_gram').value) || 900;

  const totalDailyCost = materialsTotal + laborDay + rentDay + utilitiesDay;
  const costPerPackage = totalDailyCost / packagesDay;
  const costPerKg = totalDailyCost / (packagesDay * (weightGram/1000));

  return {
    materialsTotal, laborDay, rentDay, utilitiesDay,
    totalDailyCost, costPerPackage, costPerKg, packagesDay
  };
}

let pieChart=null, lineChart=null, forecastChart=null, priceHistoryChart=null;

// جلوگیری از کرش اگر Chart.js لود نشده باشد
function safeChart(ctx, config) {
  if (typeof Chart === 'undefined') {
    console.warn('Chart.js در دسترس نیست');
    return null;
  }
  try {
    return new Chart(ctx, config);
  } catch(e) {
    console.error('خطا در ساخت نمودار:', e);
    return null;
  }
}

function setDefaults(){
  const defaults = {
    price1:1500000, price2:500000, price3:27000, price4:1700000, price5:1700000,
    price6:300000, price7:55000, price8:160000, price9:10000,
    price10:180000, price11:120000, // زنجبیل و بیکینگ‌پودر
    use1:20.32, use2:11.5, use3:16.6, use4:3.64, use5:0.32, use6:0.8, use7:0.32, use8:0.4, use9:0.02,
    use10:0.05, use11:0.03, // مصرف پیش‌فرض
    labor_month:37000000, rent_month:0, utilities_day:100000, packages_day:45, weight_gram:920,
    wholesale_price:180000, retail_price:200000, forecastDays:7
  };
  for(const k in defaults){
    const el = document.getElementById(k);
    if(el && (!el.value || el.value === '')) {
      el.value = defaults[k];
    }
  }
  const bn = localStorage.getItem('nk_brand') || 'مجتمع سنت';
  document.getElementById('brandName').value = bn;
  document.getElementById('brandNameDisplay').innerText = bn;
  document.getElementById('brandBadge').innerText = bn;
  const mobileBrand = document.getElementById('brandNameMobile');
  if(mobileBrand) mobileBrand.value = bn;
}

async function loadSettingsToUI(){
  if (idb) {
    idbGetAll('settings').then(arr=>{
      arr.forEach(item=>{
        try{
          if(item.key && document.getElementById(item.key)) document.getElementById(item.key).value = item.value;
        }catch(e){}
      });
    }).catch(()=>{});
  } else {
    // localStorage fallback
    try {
      const raw = localStorage.getItem(STORAGE_KEY_SETTINGS);
      if (raw) {
        const obj = JSON.parse(raw);
        for (const k in obj) {
          const el = document.getElementById(k);
          if (el) el.value = obj[k];
        }
      }
    } catch(_){}
  }
  const bn = localStorage.getItem('nk_brand');
  if(bn){ 
    document.getElementById('brandNameDisplay').innerText = bn; 
    document.getElementById('brandBadge').innerText = bn; 
    const mobileBrand = document.getElementById('brandNameMobile');
    if(mobileBrand) mobileBrand.value = bn;
  }
}

async function saveSettings(){
  const ready = await ensureIdb();
  // کامل تا ۱۱
  const ids = ['price1','price2','price3','price4','price5','price6','price7','price8','price9','price10','price11',
               'use1','use2','use3','use4','use5','use6','use7','use8','use9','use10','use11',
               'labor_month','rent_month','utilities_day','packages_day','weight_gram','wholesale_price','retail_price','forecastDays'];
  
  const brand = document.getElementById('brandName').value || 'مجتمع سنت';
  localStorage.setItem('nk_brand', brand);
  document.getElementById('brandNameDisplay').innerText = brand;
  document.getElementById('brandBadge').innerText = brand;
  const mobileBrand = document.getElementById('brandNameMobile');
  if(mobileBrand) mobileBrand.value = brand;

  if (ready) {
    const promises = ids.map(id => {
      const el = document.getElementById(id);
      return el ? idbPut('settings', { key: id, value: el.value }) : Promise.resolve();
    });
    Promise.all([...promises, idbPut('settings', { key: 'brandName', value: brand })])
      .then(() => alert('تنظیمات ذخیره شد.'))
      .catch(err => console.warn('خطا در ذخیره تنظیمات:', err));
  } else {
    // localStorage fallback for settings
    try {
      const settingsObj = {};
      ids.forEach(id => {
        const el = document.getElementById(id);
        if (el) settingsObj[id] = el.value;
      });
      settingsObj.brandName = brand;
      localStorage.setItem(STORAGE_KEY_SETTINGS, JSON.stringify(settingsObj));
      alert('تنظیمات ذخیره شد (حالت محلی).');
    } catch(e) {
      alert('خطا در ذخیره تنظیمات.');
    }
  }
}

async function snapshotPrices(){
  const entry = { t: new Date().toISOString(), prices: {} };
  for(let i=1;i<=11;i++) entry.prices['p'+i] = parseFloat(document.getElementById('price'+i)?.value) || 0;

  const ready = await ensureIdb();
  if (ready) {
    await idbPut('priceHistory', entry);
    await updatePriceHistoryChart();
    alert('وضعیت قیمت‌ها ذخیره شد.');
  } else {
    // Fallback to localStorage
    try {
      const key = STORAGE_KEY_PRICE_HISTORY;
      const existing = JSON.parse(localStorage.getItem(key) || '[]');
      existing.push(entry);
      localStorage.setItem(key, JSON.stringify(existing));
      await updatePriceHistoryChart();
      alert('وضعیت قیمت‌ها ذخیره شد (حالت محلی).');
    } catch(e) {
      console.error(e);
      alert('خطا در ذخیره قیمت‌ها. لطفاً صفحه را رفرش کنید یا از حالت ناشناس خارج شوید.');
    }
  }
}

async function updatePriceHistoryChart(){
  try {
    let ph = [];
    if (idb) {
      ph = await idbGetAll('priceHistory');
    } else {
      // localStorage fallback
      try {
        ph = JSON.parse(localStorage.getItem(STORAGE_KEY_PRICE_HISTORY) || '[]');
      } catch(_) { ph = []; }
    }
    
    const countEl = document.getElementById('priceHistoryCount');
    if(countEl) countEl.innerText = ph.length;
    
    if(ph.length === 0){ 
      if(priceHistoryChart){ 
        priceHistoryChart.destroy(); 
        priceHistoryChart = null; 
      } 
      return; 
    }
    
    const labels = ph.map(e => {
      try {
        return new Date(e.t).toLocaleDateString('fa-IR');
      } catch(err) {
        return '—';
      }
    });
    
    const colors = [
      '#bfa46f','#9e7f45','#d4c08a','#8fbf8f',
      '#c28b3d','#f2d5a8','#a3c1b9','#d1b58a','#b0a07b',
      '#7a9e7e','#c9a86c'
    ];
    
    const materialNames = ['آرد کامل','آرد سفید','شیر','روغن','خمیرمایه','نمک','شکر','آب پنیر','ادویه','زنجبیل','بیکینگ‌پودر'];
    
    const datasets = [];
    for(let i=1; i<=11; i++){
      const dataSeries = ph.map(e => {
        const val = e.prices ? (e.prices['p'+i] || 0) : 0;
        return typeof val === 'number' ? val : 0;
      });
      datasets.push({ 
        label: materialNames[i-1] || `ماده ${i}`, 
        data: dataSeries, 
        borderColor: colors[(i-1) % colors.length], 
        tension: 0.2, 
        fill: false,
        hidden: i > 6
      });
    }
    const ctx = document.getElementById('priceHistoryChart')?.getContext('2d');
    if(!ctx) return;
    if(priceHistoryChart) priceHistoryChart.destroy();
    priceHistoryChart = safeChart(ctx, { 
      type:'line', 
      data:{ labels, datasets }, 
      options:{ 
        plugins:{ legend:{position:'bottom'} }, 
        scales:{ y:{ beginAtZero:false } },
        responsive: true,
        maintainAspectRatio: false
      } 
    });
  } catch(err) {
    console.error('Error updating price history chart:', err);
  }
}

async function loadLogs(){
  try {
    if(idb){
      const arr = await idbGetAll('logs');
      if(!Array.isArray(arr)) return loadLogsLocal();
      return arr.sort((a,b) => {
        try { return a.date.localeCompare(b.date); } catch(err) { return 0; }
      });
    }
    return loadLogsLocal();
  } catch(err) {
    console.error('Error loading logs:', err);
    return loadLogsLocal();
  }
}

async function saveLogs(arr){
  if(!Array.isArray(arr)) return false;
  
  try {
    if(idb){
      const existing = await idbGetAll('logs');
      for(const e of existing) await idbDelete('logs', e.date);
      
      const saves = arr.map(r => {
        if(!r.date) return Promise.resolve();
        return idbPut('logs', r);
      });
      await Promise.all(saves);
      // also keep a localStorage copy for safety
      saveLogsLocal(arr);
      return true;
    } else {
      saveLogsLocal(arr);
      return true;
    }
  } catch(err) {
    console.error('Error saving logs:', err);
    // last resort
    try { saveLogsLocal(arr); return true; } catch(_) { return false; }
  }
}

function formatToman(x){ return (Math.round(x)).toLocaleString('fa-IR') + ' تومان'; }

async function calc(){
  try {
    const data = computeCosts();
    if(!data) return;
    
    const wholesale = parseFloat(document.getElementById('wholesale_price')?.value) || 0;
    const retail = parseFloat(document.getElementById('retail_price')?.value) || 0;
    
    const avgPrice = (wholesale + retail) / 2;
    const profitPerPackAvg = avgPrice - data.costPerPackage;
    const profitPercent = avgPrice > 0 ? Math.max(0, (profitPerPackAvg/avgPrice) * 100) : 0;
    const dailyProfitTotal = profitPerPackAvg * data.packagesDay;

    try {
      const kpiUpdates = [
        { id: 'costPerPack', value: data.costPerPackage },
        { id: 'costPerKg', value: data.costPerKg },
        { id: 'profitAvg', value: profitPerPackAvg },
        { id: 'dailyProfitTotal', value: dailyProfitTotal }
      ];
      
      kpiUpdates.forEach(({id, value}) => {
        const el = document.getElementById(id);
        if(el) el.innerText = isFinite(value) ? formatToman(value) : '—';
      });

      const profitPercentRounded = Math.round(profitPercent * 10) / 10;
      const pb = document.getElementById('profitBar');
      if(pb) {
        pb.style.width = Math.min(100, Math.max(0, profitPercentRounded)) + '%';
        pb.innerText = isFinite(profitPercentRounded) ? profitPercentRounded + '%' : '0%';
      }

      const ctxPie = document.getElementById('pieChart').getContext('2d');
      if(pieChart) pieChart.destroy();
      pieChart = safeChart(ctxPie,{
        type:'pie',
        data:{
          labels:['مواد اولیه','حقوق کارگر (روز)','کرایه (روز)','انرژی/بسته‌بندی'],
          datasets:[{ data:[ Math.round(data.materialsTotal), Math.round(data.laborDay), Math.round(data.rentDay), Math.round(data.utilitiesDay) ],
                     backgroundColor:['#f7d391','#d4a056','#b98a49','#eed8b1'], borderWidth:2, borderColor:'#fff'}]
        },
        options:{plugins:{legend:{position:'bottom'}}}
      });

      await renderLogs();
      await renderLineChart();

      const threshold = parseFloat(document.getElementById('alertThreshold')?.value) || 20;
      if(profitPercentRounded < threshold){
        showAlert(`⚠️ هشدار: حاشیه سود کمتر از ${threshold}% است (${profitPercentRounded}%). هزینه‌ها را بررسی کنید.`);
      } else hideAlert();

      updateQuickAnalysis();
    } catch(err) {
      console.error('Error in calc():', err);
      showAlert('خطا در محاسبهٔ داشبورد. لطفاً مقادیر ورودی را بررسی کنید.');
    }
  } catch(err) {
    console.error('Unhandled error in calc():', err);
  }
}

async function saveToday(){
  try {
    const countEl = document.getElementById('log_count');
    const count = parseFloat(countEl?.value) || 0;
    
    if(!count || count <= 0){ 
      alert('لطفاً تعداد تولید امروز را وارد کن (بیشتر از صفر).');
      return;
    }

    await ensureIdb(); // try to init if needed

    const data = computeCosts();
    if(!data) throw new Error('Failed to compute costs');

    const wholesale = parseFloat(document.getElementById('wholesale_price')?.value) || 0;
    const retail = parseFloat(document.getElementById('retail_price')?.value) || 0;
    
    if(wholesale <= 0 || retail <= 0) {
      alert('لطفاً قیمت‌های فروش را بررسی کنید.');
      return;
    }

    const avgPrice = (wholesale + retail) / 2;
    const profitPerPackAvg = avgPrice - data.costPerPackage;
    const profitToday = profitPerPackAvg * count;

    const d = new Date();
    const dateStr = d.toISOString().split('T')[0];

    const logs = await loadLogs();
    const existing = logs.find(l => l.date === dateStr);
    
    if(existing){
      existing.count = (existing.count || 0) + count;
      existing.profit = Math.round(existing.count * profitPerPackAvg);
    } else {
      logs.push({ 
        date: dateStr, 
        count: count, 
        profit: Math.round(profitToday) 
      });
    }

    const saved = await saveLogs(logs);
    if(!saved) throw new Error('Failed to save logs');

    if(countEl) countEl.value = '';
    await calc();

    const voiceEl = document.getElementById('voiceEnabled');
    if(voiceEl?.checked) {
      speak(`ثبت شد. ${count} بسته برای امروز ثبت شد. سود امروز ${formatToman(Math.round(profitToday))} می‌باشد.`);
    }

  } catch(err) {
    console.error('Error saving today\'s log:', err);
    alert('خطا در ثبت اطلاعات. لطفاً مجدداً تلاش کنید.');
  }
}

async function renderLogs(){
  const logs = await loadLogs();
  const tbody = document.querySelector('#logTable tbody');
  tbody.innerHTML = '';
  let idx=0;
  for(const rec of logs){
    idx++;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>${idx}</td><td>${rec.date}</td><td>${(rec.count||0).toLocaleString('fa-IR')}</td>
      <td>${(rec.profit||0).toLocaleString('fa-IR')}</td>
      <td style="white-space:nowrap">
        <button class="btn-muted" style="padding:5px 8px;font-size:12px;margin-left:4px" onclick="editLog('${rec.date}')">ویرایش</button>
        <button class="btn-danger" style="padding:5px 8px;font-size:12px" onclick="deleteLog('${rec.date}')">حذف</button>
      </td>`;
    tbody.appendChild(tr);
  }
}

async function editLog(date){
  await ensureIdb();
  const logs = await loadLogs();
  const rec = logs.find(l => l.date === date);
  if(!rec) return alert('رکورد پیدا نشد.');

  const newCount = prompt(`تعداد بسته برای تاریخ ${date} را وارد کنید (فعلی: ${rec.count}):`, rec.count);
  if(newCount === null) return;
  const count = parseFloat(newCount);
  if(isNaN(count) || count < 0) return alert('عدد معتبر وارد کنید.');

  const data = computeCosts();
  const wholesale = parseFloat(document.getElementById('wholesale_price')?.value) || 0;
  const retail = parseFloat(document.getElementById('retail_price')?.value) || 0;
  const avgPrice = (wholesale + retail) / 2;
  const profitPerPackAvg = avgPrice - data.costPerPackage;

  rec.count = count;
  rec.profit = Math.round(count * profitPerPackAvg);

  await saveLogs(logs);
  await renderLogs();
  await renderLineChart();
  await calc();
  alert('رکورد ویرایش شد.');
}

async function deleteLog(date){
  await ensureIdb();
  if(!confirm('مطمئنی می‌خوای این رکورد حذف بشه؟')) return;
  if (idb) {
    await idbDelete('logs', date);
  } else {
    let logs = loadLogsLocal();
    logs = logs.filter(l => l.date !== date);
    saveLogsLocal(logs);
  }
  await renderLogs();
  await renderLineChart();
  await calc();
}

async function clearLogs(){
  await ensureIdb();
  if(!confirm('پاک کردن تمام رکوردها؟ این کار برگشت‌پذیر نیست.')) return;
  if (idb) {
    const all = await idbGetAll('logs');
    for(const e of all) await idbDelete('logs', e.date);
  } else {
    saveLogsLocal([]);
  }
  await renderLogs();
  await renderLineChart();
  await calc();
}

async function renderLineChart(){
  const logs = await loadLogs();
  const recent = logs.slice(-60);
  const labels = recent.map(l => l.date);
  const profits = recent.map(l => l.profit);

  const canvas = document.getElementById('lineChart');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  if(lineChart && lineChart.destroy) lineChart.destroy();
  lineChart = safeChart(ctx, {
    type:'line',
    data:{ 
      labels, 
      datasets:[{ 
        label:'سود روزانه (تومان)', 
        data: profits, 
        fill:true, 
        backgroundColor:'rgba(46,125,50,0.08)',
        borderColor:'#1b5e20',
        tension:0.3,
        pointRadius:4,
        pointHoverRadius: 6
      }] 
    },
    options:{ 
      responsive:true, 
      maintainAspectRatio:false, 
      scales:{ 
        y:{ 
          beginAtZero:true,
          ticks: { callback: function(value) { return value.toLocaleString('fa-IR'); } }
        },
        x: { 
          grid: { display: false }
        }
      }, 
      plugins:{ legend:{display:false} } 
    }
  });
  canvas.parentElement.style.minHeight = '180px';
}

async function trainForecastModel() {
  const logs = await loadLogs();
  if (!logs || logs.length < 8) return null;
  
  let xs, ys, xNorm, yNorm, xMean, xStd, yMean, yStd;
  
  try {
    const tf = await ensureTF();
    const profits = logs.map(l => l.profit);
    const n = profits.length;

    xs = tf.tensor1d(profits.map((_, i) => i));
    ys = tf.tensor1d(profits);

    xMean = xs.mean();
    xStd = xs.sub(xMean).square().mean().sqrt().add(1e-6);
    yMean = ys.mean();
    yStd = ys.sub(yMean).square().mean().sqrt().add(1e-6);

    xNorm = xs.sub(xMean).div(xStd);
    yNorm = ys.sub(yMean).div(yStd);

    const model = tf.sequential();
    model.add(tf.layers.dense({ units: 24, activation: 'relu', inputShape: [1] }));
    model.add(tf.layers.dense({ units: 12, activation: 'relu' }));
    model.add(tf.layers.dense({ units: 1 }));
    model.compile({ optimizer: tf.train.adam(0.03), loss: 'meanSquaredError' });

    const xs2 = xNorm.reshape([n,1]);
    const ys2 = yNorm.reshape([n,1]);
    try{
      await model.fit(xs2, ys2, { epochs: 80, batchSize: Math.min(8, n), shuffle: false, verbose: 0 });
    }catch(e){ 
      console.warn('TF training error', e); 
      xs.dispose(); ys.dispose(); 
      return null; 
    }

    if(idb){
        try{
            await model.save('indexeddb://profit-forecast');
            await idbPut('settings', { key: 'profit_forecast_meta', value: { 
              xMean: await xMean.array(), xStd: await xStd.array(), 
              yMean: await yMean.array(), yStd: await yStd.array(), 
              trainedAt: new Date().toISOString() 
            }});
        }catch(e){ console.warn('Could not save TF model to IndexedDB', e); }
    }

    const meta = {
      model,
      xMean: await xMean.array(),
      xStd: await xStd.array(),
      yMean: await yMean.array(),
      yStd: await yStd.array(),
      isNew: true // flag for dispose
    };
    xs.dispose(); ys.dispose(); xNorm.dispose(); yNorm.dispose(); xs2.dispose(); ys2.dispose();
    return meta;
  } catch(err) {
    console.error('Error in trainForecastModel:', err);
    try{ if(xs) xs.dispose(); }catch(_){ }
    try{ if(ys) ys.dispose(); }catch(_){ }
    try{ if(xNorm) xNorm.dispose(); }catch(_){ }
    try{ if(yNorm) yNorm.dispose(); }catch(_){ }
    return null;
  }
}

async function predictNextProfits(days=7) {
  try {
    const logs = await loadLogs();
    if (!logs || logs.length === 0) return {series: [], method: 'none', confidence: 0};
    const tf = await ensureTF();
    let model = null;
    let metaStats = null;

    if(idb){
        try{
          model = await tf.loadLayersModel('indexeddb://profit-forecast');
          const metaItems = await new Promise((res)=>{ 
            const tx = idb.transaction('settings','readonly'); 
            const st = tx.objectStore('settings'); 
            const req = st.get('profit_forecast_meta'); 
            req.onsuccess = ()=>res(req.result && req.result.value); 
            req.onerror = ()=>res(null); 
          });
          metaStats = metaItems || null;
        }catch(e){ model = null; }
    }

    let trained = null;
    if(model && metaStats){
      trained = { model, xMean: metaStats.xMean, xStd: metaStats.xStd, yMean: metaStats.yMean, yStd: metaStats.yStd, isNew: false };
    } else {
      trained = await trainForecastModel();
    }

    if(!trained || !trained.model) return simpleMAForecast(logs, days);
    
    const lastIndex = logs.length - 1;
    const forecast = [];
    let confidence = 0;
    
    for (let i = 1; i <= days; i++) {
      const idx = lastIndex + i;
      const xRaw = idx;
      const x = (xRaw - trained.xMean) / trained.xStd;

      let input = null, yPredNorm = null, yPred = null;
      try {
        input = tf.tensor2d([x], [1,1]);
        yPredNorm = trained.model.predict(input);
        if(Array.isArray(yPredNorm)) yPredNorm = yPredNorm[0];
        yPred = yPredNorm.mul(trained.yStd).add(trained.yMean);
        const arr = await yPred.array();
        const v = Math.max(0, Math.round(arr[0][0]));
        forecast.push(v);
      } finally {
        if (input) input.dispose();
        try{ if (yPredNorm && yPredNorm.dispose) yPredNorm.dispose(); }catch(_){ }
        try{ if (yPred && yPred.dispose) yPred.dispose(); }catch(_){ }
      }
    }

    const recent = logs.slice(-7).map(l => l.profit);
    const meanRecent = recent.reduce((a,b)=>a+b,0)/recent.length;
    const varRecent = recent.map(v => Math.pow(v-meanRecent,2)).reduce((a,b)=>a+b,0)/recent.length;
    const stdRecent = Math.sqrt(varRecent) || 1;
    const predMean = forecast.reduce((a,b)=>a+b,0)/forecast.length;
    const rel = 1 - (Math.abs(predMean - meanRecent) / (Math.abs(meanRecent) + 1));
    confidence = Math.max(0, Math.min(100, Math.round((rel * 100) * (1 / (1 + stdRecent/Math.max(1, Math.abs(meanRecent)))))));
    
    // فقط مدل تازه آموزش‌دیده را dispose کن
    try{ if(trained && trained.model && trained.isNew) trained.model.dispose(); }catch(_){ }
    
    return { series: forecast, method: 'tfjs', confidence };
  } catch(err) {
    console.warn('TF predict error, fallback', err);
    try{ if(logs) return simpleMAForecast(logs, days); }catch(_){ }
    return { series: [], method: 'none', confidence: 0 };
  }
}

function simpleMAForecast(logs, days=7){
  const lastN = Math.min(7, logs.length);
  const recent = logs.slice(-lastN).map(l => l.profit);
  const avg = recent.reduce((a,b)=>a+b,0)/recent.length;
  const series = [];
  for(let i=0;i<days;i++) series.push(Math.max(0, Math.round(avg)));
  const conf = Math.max(30, Math.round(80 - (recent.reduce((a,b)=>a+Math.abs(b-avg),0)/ (avg+1))));
  return { series, method:'ma', confidence: conf };
}

async function runLocalAIForecast(days = 7) {
  const res = await predictNextProfits(days);
  const fcSum = res.series.reduce((a,b)=>a+b,0);
  document.getElementById('forecastSummary').innerText = `پیش‌بینی ${res.series.length} روز آینده: مجموع ≈ ${fcSum.toLocaleString('fa-IR')} تومان — اعتماد ${res.confidence}% (روش: ${res.method})`;
  renderForecastChart(res.series);
  if(document.getElementById('voiceEnabled').checked) speak(`پیش‌بینی ${res.series.length} روز آینده انجام شد. اعتماد مدل ${res.confidence} درصد است.`);
  return res;
}

function renderForecastChart(series){
  (async ()=>{
    const logs = await loadLogs();
    const recent = logs.slice(-30);
    const labels = recent.map(l=> l.date);
    const real = recent.map(l=> l.profit);
    const forecastSeries = series || [];
    const now = recent.length? new Date(recent[recent.length-1].date): new Date();
    const forecastLabels = [];
    for(let i=1;i<=forecastSeries.length;i++){
      const d = new Date(now); d.setDate(d.getDate()+i);
      const yyyy = d.getFullYear(); const mm = String(d.getMonth()+1).padStart(2,'0'); const dd = String(d.getDate()).padStart(2,'0');
      forecastLabels.push(`${yyyy}-${mm}-${dd}`);
    }
    const allLabels = labels.concat(forecastLabels);
    const realPadded = real.concat(new Array(forecastSeries.length).fill(null));
    const forecastPadded = new Array(labels.length).fill(null).concat(forecastSeries);

    const canvas = document.getElementById('lineChart');
    const ctx = canvas.getContext('2d');
    if(lineChart) lineChart.destroy();
    lineChart = safeChart(ctx, {
      type:'line',
      data:{
        labels: allLabels,
        datasets:[
          { label:'سود واقعی', data: realPadded, borderColor:'#1b5e20', backgroundColor:'rgba(46,125,50,0.08)', tension:0.3, fill:true, pointRadius:4, pointHoverRadius: 6 },
          { label:'پیش‌بینی', data: forecastPadded, borderColor:'#c5a972', borderWidth: 3, borderDash:[8,6], backgroundColor:'rgba(197,169,114,0.08)', tension:0.3, pointRadius:4, pointHoverRadius: 6 }
        ]
      },
      options:{
        responsive:true,
        maintainAspectRatio:false,
        plugins:{ legend:{position:'bottom', labels:{boxWidth:12} } },
        scales:{ y:{ beginAtZero:true } },
        interaction: { mode: 'index', intersect: false }
      }
    });
    canvas.parentElement.style.minHeight = '180px';
  })();
}

let resizeTimer = null;
window.addEventListener('resize', ()=>{
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(()=>{ renderLineChart(); }, 200);
});

async function downloadCSV(){
  const logs = await loadLogs();
  if(!logs.length){ alert('هیچ رکوردی برای خروجی وجود ندارد.'); return; }
  let csv = 'تاریخ,تعداد,سود\n';
  logs.forEach((l)=>{ csv += `${l.date},${l.count},${l.profit}\n`; });
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'nk_logs.csv'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}

function importCSVFile(file){
  const reader = new FileReader();
  reader.onload = async function(e){
    await ensureIdb();
    const txt = e.target.result; const lines = txt.split(/\r?\n/).filter(Boolean);
    if(lines.length < 2) return alert('CSV نامعتبر');
    const items = [];
    for(let i=1;i<lines.length;i++){
      const cols = lines[i].split(',');
      if(cols.length < 3) continue;
      let date, count, profit;
      if(cols.length >= 4){
        date = cols[1].trim();
        count = parseInt(cols[2])||0;
        profit = parseFloat(cols[3])||0;
      } else {
        date = cols[0].trim();
        count = parseInt(cols[1])||0;
        profit = parseFloat(cols[2])||0;
      }
      if(date) items.push({ date, count, profit });
    }

    if (idb) {
      const tx = idb.transaction('logs','readwrite'); 
      const st = tx.objectStore('logs');
      items.forEach(it=> st.put(it));
      tx.oncomplete = async ()=>{ await renderLogs(); await renderLineChart(); await calc(); alert('واردسازی CSV انجام شد'); };
      tx.onerror = ()=> alert('خطا در واردسازی CSV');
    } else {
      // localStorage fallback
      const existing = loadLogsLocal();
      const map = {};
      existing.forEach(l => map[l.date] = l);
      items.forEach(it => map[it.date] = it);
      saveLogsLocal(Object.values(map));
      await renderLogs(); await renderLineChart(); await calc();
      alert('واردسازی CSV انجام شد (حالت محلی).');
    }
  };
  reader.readAsText(file,'utf-8');
}

const csvInput = document.createElement('input'); csvInput.type='file'; csvInput.accept='.csv'; csvInput.style.display='none';
csvInput.onchange = (e)=>{ if(e.target.files && e.target.files[0]) importCSVFile(e.target.files[0]); };
document.body.appendChild(csvInput);

function showAlert(msg){
  const box = document.getElementById('alertBox');
  box.style.display = 'block';
  box.innerText = msg;
  if(document.getElementById('voiceEnabled')?.checked) speak(msg);
}
function hideAlert(){ const box = document.getElementById('alertBox'); box.style.display='none'; box.innerText=''; }

function analyzeTrend(windowSize=10){
  const logsRaw = loadLogsLocalSync();
  const logs = logsRaw.slice(-windowSize);
  if(logs.length < 3) return {trend:'⚖️ داده کافی نیست', slope:0};
  const y = logs.map(l=> l.count || 0);
  const x = y.map((v,i)=> i);
  const n = x.length;
  const xMean = x.reduce((a,b)=>a+b,0)/n;
  const yMean = y.reduce((a,b)=>a+b,0)/n;
  let num=0, den=0;
  for(let i=0;i<n;i++){ num += (x[i]-xMean)*(y[i]-yMean); den += (x[i]-xMean)*(x[i]-xMean); }
  const slope = den===0?0:(num/den);
  const trend = slope > 0.1 ? '📈 تولید در حال رشد' : (slope < -0.1 ? '📉 تولید در حال کاهش' : '⚖️ تولید نسبتاً ثابت');
  return { trend, slope, avg: yMean };
}

function loadLogsLocalSync(){
  try{ return JSON.parse(localStorage.getItem(STORAGE_KEY_LOGS) || '[]'); }catch(e){ return []; }
}

function computeBreakEven(){
  const data = computeCosts();
  const wholesale = parseFloat(document.getElementById('wholesale_price').value) || 0;
  const retail = parseFloat(document.getElementById('retail_price').value) || 0;
  const avgPrice = (wholesale + retail)/2;
  if(avgPrice <= 0) return { packs: null, note: 'قیمت فروش وارد نشده' };
  const packs = Math.ceil(data.totalDailyCost / avgPrice);
  return { packs, avgPrice: Math.round(avgPrice) };
}

function analyzePriceImpact(){
  const base = computeCosts();
  const baseCostPer = base.costPerPackage;
  const impacts = [];
  for(let i=1;i<=11;i++){
    const orig = parseFloat(document.getElementById('price'+i).value) || 0;
    if(orig === 0) continue;
    const newp = orig * 1.05;
    document.getElementById('price'+i).value = newp;
    const newCost = computeCosts();
    const newCPP = newCost.costPerPackage;
    document.getElementById('price'+i).value = orig;
    const deltaPercent = ((newCPP - baseCostPer)/baseCostPer)*100;
    impacts.push({ i, deltaPercent });
  }
  impacts.sort((a,b)=>Math.abs(b.deltaPercent)-Math.abs(a.deltaPercent));
  const materialNames = ['آرد کامل','آرد سفید','شیر','روغن','خمیرمایه','نمک','شکر','آب پنیر','ادویه','زنجبیل','بیکینگ‌پودر'];
  const top = impacts.slice(0,3).map(it=> `${materialNames[it.i-1]||('ماده '+it.i)}: ${it.deltaPercent.toFixed(2)}%`).join(' — ');
  return top || 'بدون تغییر';
}

async function updateQuickAnalysis(){
  const trendInfo = analyzeTrend(10);
  document.getElementById('trendSummary').innerText = 'تحلیل روند: ' + trendInfo.trend;

  const fc = await predictNextProfits(parseInt(document.getElementById('forecastDays')?.value) || 7);
  document.getElementById('forecastSummary').innerText = `پیش‌بینی ${fc.series.length} روز: مجموع ≈ ${fc.series.reduce((a,b)=>a+b,0).toLocaleString('fa-IR')} تومان — اعتماد ${fc.confidence}%`;

  const be = computeBreakEven();
  document.getElementById('breakEven').innerText = be.packs ? `نقطه سر به سر ≈ ${be.packs} بسته در روز (قیمت متوسط ${be.avgPrice.toLocaleString('fa-IR')} تومان)` : be.note;

  const impact = analyzePriceImpact();
  document.getElementById('priceImpact').innerText = `تأثیر قیمت‌ها (5% افزایش): ${impact}`;

  const goal = parseFloat(document.getElementById('monthlyGoal').value) || 0;
  if(goal>0){
    const logs = await loadLogs();
    const month = (new Date()).toISOString().slice(0,7);
    const monthLogs = logs.filter(l=> l.date.slice(0,7) === month);
    const sumProfit = monthLogs.reduce((a,b)=>a+(b.profit||0),0);
    const perc = Math.min(100, Math.round((sumProfit/goal)*100));
    document.getElementById('goalProgress').style.width = perc + '%';
    document.getElementById('goalProgress').innerText = perc + '%';
    document.getElementById('goalStatus').innerText = `تا کنون ${sumProfit.toLocaleString('fa-IR')} تومان — ${perc}% از هدف`;
  } else {
    document.getElementById('goalStatus').innerText = 'هدف ماهانه تنظیم نشده';
  }
}

function suggestPrice(){
  const targetMarginPct = parseFloat(document.getElementById('targetMargin').value) || 25;
  const data = computeCosts();
  const costPerPack = data.costPerPackage;
  const neededPrice = costPerPack / (1 - targetMarginPct/100);
  const retailSuggest = Math.ceil(neededPrice * 1.1);
  const wholesaleSuggest = Math.ceil(neededPrice * 0.9);
  document.getElementById('suggestedPrices').innerText = `${wholesaleSuggest.toLocaleString('fa-IR')} تومان / ${retailSuggest.toLocaleString('fa-IR')} تومان`;
  if(document.getElementById('voiceEnabled').checked) speak(`پیشنهاد قیمت برای حفظ حاشیه سود ${targetMarginPct} درصد آماده شد.`);
  return { wholesaleSuggest, retailSuggest };
}

function speak(text){
  try{
    if(!document.getElementById('voiceEnabled')?.checked) return;
    const synth = window.speechSynthesis;
    if(!synth) return;
    const msg = new SpeechSynthesisUtterance(text);
    msg.lang = 'fa-IR';
    msg.rate = 0.95;
    msg.pitch = 1;
    const voices = synth.getVoices();
    let v = voices.find(v=>/persian|farsi|iran/i.test(v.name)) || voices.find(v=>/google|microsoft|yandex/i.test(v.name)) || voices[0];
    if(v) msg.voice = v;
    synth.speak(msg);
  }catch(e){ console.warn('speech error', e); }
}
function toggleVoice(){
  const el = document.getElementById('voiceEnabled');
  el.checked = !el.checked;
  speak(el.checked ? 'سیستم گفتاری فعال شد' : 'سیستم گفتاری غیرفعال شد');
}

function showHelp(){ document.getElementById('helpModal').style.display='flex'; }
function hideHelp(){ document.getElementById('helpModal').style.display='none'; }

function openSidebar(){ 
  const s = document.getElementById('mobileSidebar'); 
  const ov = document.getElementById('sidebarOverlay');
  if(!s) return; 
  s.classList.add('open'); 
  s.setAttribute('aria-hidden','false'); 
  if(ov) ov.classList.add('show');
  const hb = document.getElementById('hamburgerBtn'); 
  if(hb) hb.setAttribute('aria-expanded','true'); 
  document.body.classList.add('sidebar-open');
}
function closeSidebar(){ 
  const s = document.getElementById('mobileSidebar'); 
  const ov = document.getElementById('sidebarOverlay');
  if(!s) return; 
  s.classList.remove('open'); 
  s.setAttribute('aria-hidden','true'); 
  if(ov) ov.classList.remove('show');
  const hb = document.getElementById('hamburgerBtn'); 
  if(hb) hb.setAttribute('aria-expanded','false'); 
  document.body.classList.remove('sidebar-open');
}

document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') { hideHelp(); closeSidebar(); } });

async function exportAll(){
  const logs = await loadLogs();
  const ph = await idbGetAll('priceHistory');
  const settings = await idbGetAll('settings');
  const data = { logs, priceHistory: ph, settings, exportedAt: new Date().toISOString() };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'nk_backup.json'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
}

function applyBrand(){
  const b = document.getElementById('brandName').value || 'مجتمع سنت';
  localStorage.setItem('nk_brand', b);
  document.getElementById('brandNameDisplay').innerText = b;
  document.getElementById('brandBadge').innerText = b;
  document.getElementById('brandLogo').innerText = b[0] || 'س';
  const mobileBrand = document.getElementById('brandNameMobile');
  if(mobileBrand) mobileBrand.value = b;
  alert('برند اعمال شد: ' + b);
}
function applyBrandMobile(){
  const b = document.getElementById('brandNameMobile').value || 'مجتمع سنت';
  document.getElementById('brandName').value = b;
  applyBrand();
}
function applyGoal(){ const g = parseFloat(document.getElementById('monthlyGoal').value)||0; if(g>0) alert('هدف ماهانه تنظیم شد.'); updateQuickAnalysis(); }

// گزارش ماهانه قابل چاپ
async function printMonthlyReport(){
  const logs = await loadLogs();
  const month = (new Date()).toISOString().slice(0,7);
  const monthLogs = logs.filter(l => l.date.slice(0,7) === month);
  const totalCount = monthLogs.reduce((a,b)=>a+(b.count||0),0);
  const totalProfit = monthLogs.reduce((a,b)=>a+(b.profit||0),0);
  const data = computeCosts();
  const brand = document.getElementById('brandNameDisplay').innerText || 'مجتمع سنت';

  const win = window.open('', '_blank');
  win.document.write(`
    <html dir="rtl" lang="fa">
    <head>
      <title>گزارش ماهانه - ${brand}</title>
      <style>
        body{font-family:Tahoma,sans-serif;padding:24px;color:#222}
        h1{color:#a68c5b}
        table{width:100%;border-collapse:collapse;margin-top:16px}
        th,td{border:1px solid #ddd;padding:8px;text-align:center}
        th{background:#f7f4ee}
        .summary{margin:16px 0;padding:12px;background:#f9f6ef;border-radius:8px}
        @media print{button{display:none}}
      </style>
    </head>
    <body>
      <h1>گزارش ماهانه تولید نان خشکه</h1>
      <p><b>برند:</b> ${brand} &nbsp;|&nbsp; <b>ماه:</b> ${month}</p>
      <div class="summary">
        <p>تعداد کل بسته‌های تولیدشده: <b>${totalCount.toLocaleString('fa-IR')}</b></p>
        <p>سود کل ماه: <b>${totalProfit.toLocaleString('fa-IR')} تومان</b></p>
        <p>قیمت تمام‌شده هر بسته (بر اساس تنظیمات فعلی): <b>${formatToman(data.costPerPackage)}</b></p>
        <p>تعداد روزهای ثبت‌شده: <b>${monthLogs.length}</b></p>
      </div>
      <table>
        <thead><tr><th>تاریخ</th><th>تعداد بسته</th><th>سود روز</th></tr></thead>
        <tbody>
          ${monthLogs.map(l=>`<tr><td>${l.date}</td><td>${(l.count||0).toLocaleString('fa-IR')}</td><td>${(l.profit||0).toLocaleString('fa-IR')}</td></tr>`).join('')}
        </tbody>
      </table>
      <br><button onclick="window.print()">🖨 چاپ گزارش</button>
      <p style="font-size:12px;color:#888;margin-top:24px">تولید شده توسط سیستم هوشمند مدیریت نان خشکه</p>
    </body>
    </html>
  `);
  win.document.close();
}

async function runAIAnalysis(){
  await calc();
  await runLocalAIForecast(parseInt(document.getElementById('forecastDays').value||7));
  if(document.getElementById('voiceEnabled').checked) speak('تحلیل هوشمند کامل شد.');
}

window.addEventListener('load', async () => {
  try {
    await initIndexedDB();
    
    const debouncePriceChange = (function(){
      let timeoutId;
      return async function() {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(async function() {
          try {
            let ph = [];
            if (idb) ph = await idbGetAll('priceHistory');
            else {
              try { ph = JSON.parse(localStorage.getItem(STORAGE_KEY_PRICE_HISTORY) || '[]'); } catch(_){}
            }
            const current = {};
            for(let j=1; j<=11; j++) {
              const priceEl = document.getElementById('price'+j);
              current['p'+j] = parseFloat(priceEl?.value) || 0;
            }
            
            const last = ph.length ? ph[ph.length-1].prices : null;
            let changed = !last;
            
            if(last) {
              for(let j=1; j<=11; j++) { 
                if((last['p'+j]||0) !== (current['p'+j]||0)) { 
                  changed = true; 
                  break; 
                } 
              }
            }

            if(changed) {
              const entry = { t: new Date().toISOString(), prices: current };
              if (idb) {
                await idbPut('priceHistory', entry);
              } else {
                ph.push(entry);
                localStorage.setItem(STORAGE_KEY_PRICE_HISTORY, JSON.stringify(ph));
              }
              await updatePriceHistoryChart();
            }
          } catch(err) {
            console.error('Error processing price changes:', err);
          }
        }, 500);
      };
    })();

    for(let i=1; i<=11; i++) {
      const priceEl = document.getElementById('price'+i);
      if(priceEl) priceEl.addEventListener('input', debouncePriceChange);
    }

    const autoAnalyzeEl = document.getElementById('autoAnalyze');
    if(autoAnalyzeEl?.checked) {
      setTimeout(async () => {
        try {
          await calc();
          const forecastDays = parseInt(document.getElementById('forecastDays')?.value || '7');
          await runLocalAIForecast(forecastDays);
        } catch(err) {
          console.error('Error in auto analysis:', err);
        }
      }, 700);
    }

    const bn = localStorage.getItem('nk_brand') || 'مجتمع سنت';
    const elements = {
      brandNameDisplay: document.getElementById('brandNameDisplay'),
      brandBadge: document.getElementById('brandBadge'),
      brandLogo: document.getElementById('brandLogo')
    };
    if(elements.brandNameDisplay) elements.brandNameDisplay.innerText = bn;
    if(elements.brandBadge) elements.brandBadge.innerText = bn;
    if(elements.brandLogo) elements.brandLogo.innerText = bn[0] || 'س';
    const mobileBrand = document.getElementById('brandNameMobile');
    if(mobileBrand) mobileBrand.value = bn;

  } catch(err) {
    console.error('Error during initialization:', err);
  }
});
</script>
</body>
</html>
